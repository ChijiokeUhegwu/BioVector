# Distribution / Packaging / Testing
# ==============================================================================
dist/
build/
*.egg-info/
.eggs/

# Pytest / Coverage / Linting
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

